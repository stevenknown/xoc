$(info "====---- START Makefile.xinfer ----====")

ifeq ($(TARG),)
  $(error "NEED TARG INFO:e.g:make TARG=FOR_ARM TARG_DIR=../arm")
endif

ifeq ($(TARG_DIR),)
  $(error "NEED TARG_DIR INFO:e.g:make TARG=FOR_ARM TARG_DIR=./arm")
endif

ifeq ($(THREAD_NUM),)
  THREAD_NUM=1
endif

ifneq ($(ROOT_DIR),)
  $(error "DO NOT SET ROOT_DIR IN CMD-LINE, IT WILL BE SET IN MAKEFILE")
endif

CFLAGS+=-Wall
ROOT_DIR=$(CURDIR)/../../
XGEN_DIR=$(ROOT_DIR)/xgen
COM_DIR=$(ROOT_DIR)/com
READER_DIR=$(ROOT_DIR)/reader
OPT_DIR=$(ROOT_DIR)/opt
ELF_DIR=$(ROOT_DIR)/elf
MACH_DIR=$(ROOT_DIR)/mach
CFE_DIR=$(ROOT_DIR)/cfe
TARG_ABS_DIR=$(ROOT_DIR)/$(TARG_DIR)
XINFER_DIR=$(ROOT_DIR)/xinfer
XINFER_OUTPUT=xinfer.exe

include Makefile.inc
include $(COM_DIR)/Makefile.inc
include $(ROOT_DIR)/Makefile.xoc.inc
include $(XGEN_DIR)/Makefile.inc
include $(ROOT_DIR)/Makefile.option
include $(ELF_DIR)/Makefile.inc
include $(MACH_DIR)/Makefile.inc

ifeq ($(OPEN_COVERAGE),true)
  CFLAGS+=--coverage
endif

ifeq ($(DEBUG), true)
  CFLAGS+=-D_DEBUG_
  CFLAGS+=-O0 -g2
  CLINKFLAGS=
else
  CFLAGS+=-O3
  CFLAGS+=-flto
  CLINKFLAGS+=\
    -fdump-ipa-cgraph \
    -fdump-ipa-inline
endif

CFLAGS+=\
  -D$(TARG) \
  -D_DUMP_BY_LOGMGR_ \
  -D_GNU_COMPILE_ \
  -Wno-overloaded-virtual\
  -Wno-unknown-pragmas \
  -Wno-write-strings \
  -Wsign-promo \
  -Wparentheses \
  -Wformat \
  -Wsign-compare \
  -Wpointer-arith \
  -Wno-multichar \
  -Winit-self \
  -Wswitch \
  -D_SUPPORT_C11_

#Disable -Wconversion to avoid too much complaints.

ifeq ($(FOR_IP), true)
  CFLAGS+=-DFOR_IP
endif

ifneq (,$(filter $(CC),g++ gcc))
  CFLAGS+=-Wno-strict-aliasing -finline-limit=10000000
endif

#Use tmp-objs-name to compose multiple level path.
TMP_ELF_OBJS=$(foreach n,$(ELF_OBJS),$(ELF_DIR)/$(n))
TMP_MACH_OBJS=$(foreach n,$(MACH_OBJS),$(MACH_DIR)/$(n))

#Display internal variables.
$(info "CURDIR:$(CURDIR)")
$(info "ROOT_DIR:$(ROOT_DIR)")
$(info "COMBINED ELF OBJS:$(TMP_ELF_OBJS)")
$(info "WIN=$(WIN),WSL=$(WSL)")
$(info "TARG:$(TARG)")
$(info "TARG_ABS_DIR:$(TARG_ABS_DIR)")
$(info "CC:$(CC)")
$(info "INC:$(INC)")
$(info "CFLAGS:$(CFLAGS)")
$(info "DEBUG:$(DEBUG)")
$(info "THREAD_NUM:$(THREAD_NUM)")
$(info "TMP_ELF_OBJS:$(TMP_ELF_OBJS)")
$(info "TMP_MACH_OBJS:$(TMP_MACH_OBJS)")

#Define dependencies and link-rules of xinfer.exe.
$(XINFER_OUTPUT): xinfer_objs $(XGEN_OUTPUT)
	@echo "In Makefile.xinfer: START BUILD $(XINFER_OUTPUT)"
	$(CC) $(XINFER_OBJS) $(CLINKFLAGS) \
      -Xlinker "-(" \
      $(XGEN_DIR)/$(XGEN_OUTPUT) \
      $(COM_DIR)/$(COM_OUTPUT) \
      $(ROOT_DIR)/$(XOC_OUTPUT) \
      -Xlinker "-)" \
      $(CFLAGS) \
      -o $@ -lstdc++ -lm  #-lgcov -lgcc
	@echo "END BUILD $(XINFER_OUTPUT)"
	@echo "SUCCESS TO GENERATE $(XINFER_OUTPUT)!!"

%.o:%.cpp
	@echo "BUILD $<"
	$(INFER) $(CC) $(CFLAGS) -c $< -o $@

%.o:%.c
	@echo "BUILD $<"
	$(INFER) $(CC) $(CFLAGS) -c $< -o $@

tmp_elf_objs: $(TMP_ELF_OBJS)
xinfer_objs: $(XINFER_OBJS)

$(XGEN_OUTPUT):
	@echo "In Makefile.xinfer: START BUILD $(XGEN_OUTPUT)"
	make -C $(XGEN_DIR) \
      TARG=$(TARG) \
      TARG_DIR=$(TARG_ABS_DIR) \
      ROOT_DIR=$(ROOT_DIR) \
      -j$(THREAD_NUM) \
      -f Makefile.xgen \
      DEBUG=$(DEBUG) \
      CFLAGS="$(CFLAGS)" \
      THREAD_NUM=$(THREAD_NUM)
	@echo "END BUILD $(XGEN_OUTPUT)"

clean:
	@find ./ -name "*.o" | xargs rm -f
	@find ./ -name "*.i" | xargs rm -f
	@find ./ -name "*.a" | xargs rm -f
	@find ./ -name "*.d" | xargs rm -f
	@find ./ -name "*.exe" | xargs rm -f
	@find ./ -name "*.elf" | xargs rm -f
	@find ./ -name "*.out" | xargs rm -f
	@find ./ -name "*.tmp" | xargs rm -f
	@find ./ -name "*.asm" | xargs rm -f
	@find ./ -name "*.swp" | xargs rm -f
	@find ./ -name "*.swo" | xargs rm -f
	@find ./ -name "*.log" | xargs rm -f
	@find ./ -name "*.LOGLOG" | xargs rm -f
	@find ./ -name "LOGLOG" | xargs rm -f

-include $(COM_DIR)/*.d
-include $(OPT_DIR)/*.d
-include $(TARG_ABS_DIR)/*.d
-include $(XINFER_DIR)/*.d
$(info "====---- END Makefile.xinfer ----====")
